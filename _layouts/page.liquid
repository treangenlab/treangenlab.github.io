---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.topics %}
      <div class="topic-tags">
        {% for topic in page.topics %}
          <span class="topic-tag">{{ topic }}</span>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.members %}
    <h2>Lab members on this project</h2>
    <div class="project-members">
      {% for member in page.members %}
        {% assign member_path = '/' | append: member | append: '/' %}
        {% for person in site.profiles %}
          {% if person.url contains member_path %}
            {% if person.category == 'PI' or person.category == 'Current members' %}
              <a class="project-member" href="{{ person.url | relative_url }}">{{ person.title }}</a>
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
