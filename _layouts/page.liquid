---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.topics %}
      <div class="topic-tags">
        {% for topic in page.topics %}
          <span class="topic-tag">{{ topic }}</span>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <article>
    {% if page.collection == 'profiles' and page.img %}
      <div class="profile-photo">
        {% include figure.liquid loading="eager" path=page.img class="img-fluid rounded z-depth-1" alt=page.title %}
      </div>
    {% endif %}
    {{ content }}
    <div style="clear: both;"></div>
  </article>

  {% if page.members %}
    <h2>Lab members on this project</h2>
    <div class="project-members">
      {% for member in page.members %}
        {% assign member_path = '/' | append: member | append: '/' %}
        {% for person in site.profiles %}
          {% if person.url contains member_path %}
            {% if person.category == 'PI' or person.category == 'Current members' %}
              <a class="project-member" href="{{ person.url | relative_url }}">{{ person.title }}</a>
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  {% endif %}

  {% if page.collection == 'profiles' %}
    {% assign news_count = 0 %}
    {% for item in site.data.rice_news %}
      {% if item.people contains page.slug %}
        {% assign news_count = news_count | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% if news_count > 0 %}
      <h2>In Rice news</h2>
      <ul class="rice-news">
        {% for item in site.data.rice_news %}
          {% if item.people contains page.slug %}
            <li><a href="{{ item.url }}">{{ item.title }}</a> ({{ item.source }}, {{ item.year }})</li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  {% endif %}

  {% if page.project_key %}
    <h2>Papers from this project</h2>
    <div class="publications">
      {% bibliography --query @*[project ~= {{page.project_key}}] %}
    </div>
  {% endif %}

  {% if page.pub_key %}
    <h2>Papers with the Treangen Lab</h2>
    <div class="publications">
      {% bibliography --query @*[lab_authors ~= {{page.pub_key}}] %}
    </div>
  {% elsif page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% comment %} Badges (profiles only): defined in _data/badges.yml, listed per person under `badges:`; the PhD badge comes from `phd_alum`. {% endcomment %}
  {% if page.collection == 'profiles' %}
    {% if page.badges or page.phd_alum %}
      <h2 class="merit-heading">Badges</h2>
      <ul class="merit-badges" aria-label="Badges">
        {% for entry in site.data.badges %}
          {% assign key = entry[0] %}
          {% assign badge = entry[1] %}
          {% assign has = false %}
          {% if page.badges contains key %}{% assign has = true %}{% endif %}
          {% if key == 'phd' and page.phd_alum %}{% assign has = true %}{% endif %}
          {% if has %}
            <li class="merit-badge" title="{{ badge.about | escape }}" style="--b1: {{ badge.colors[0] }}; --b2: {{ badge.colors[1] }};">
              <span class="merit-medal" aria-hidden="true"><i class="fa-solid fa-{{ badge.icon }}"></i></span>
              <span class="merit-label">{{ badge.label }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
